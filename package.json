{
  "name": "sangue-e-nevoa",
  "version": "1.1.0",
  "description": "RPG narrativo inspirado em GURPS, ambientado na Escócia de 1296 a 1314, com folclore escocês.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server -c-1 -o",
    "lint": "node tools/globais.mjs && eslint js tests tools eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run lint && npm run test:story && npm run test:sabotage && npm run test:security",
    "test:story": "node tests/playthrough.mjs",
    "test:sabotage": "node tests/sabotage.mjs",
    "test:security": "node tests/security.mjs",
    "test:stress": "node tests/stress.mjs",
    "test:all": "npm test && npm run test:stress"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "playwright": "^1.47.0",
    "prettier": "^3.3.3"
  },
  "license": "MIT",
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
